font-family = "Iosevka Term Extended"
font-family-bold = "Iosevka Term Semibold Extended"
font-family-italic = "Iosevka Term Extended Italic"
font-family-bold-italic = "Iosevka Term Semibold Extended Italic"
font-size = 15
theme = "light:dayfox,dark:nightfox"
copy-on-select = "clipboard"
command = "{{ (ansible_architecture == 'arm64') | ternary ('/opt/homebrew/bin/fish', '/usr/local/bin/fish') }}"
